# Proprietary Anthropic skills (docx / pdf / xlsx) are source-available under
# Anthropic's Terms of Service and licensed for local, single-operator use only.
# They must NEVER be published to this public mirror. Guard against re-adding them
# through any skills path (Claude skills dir or the Codex plugin skills dir).
**/skills/docx/
**/skills/pdf/
**/skills/xlsx/
tasks/
.scratch/

# Live credential files must never reach this public mirror. Only the
# .example template is tracked; real secrets live TPM-sealed in
# /etc/credstore.encrypted/ and are never written here in plaintext.
restic/restic.env
restic/*.env
!restic/*.env.example
dotfiles/obs/basic/scenes/
dotfiles/obs/basic/profiles/*/service.json
dotfiles/obs/plugin_config/
dotfiles/obs/logs/
dotfiles/obs/profiler_data/
