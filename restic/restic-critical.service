[Unit]
Description=Restic Backup - critical tier to Wasabi (ck-arch)
Documentation=https://github.com/GhostKellz/arch/tree/main/restic
Wants=network-online.target
After=network-online.target
OnFailure=restic-failure@%n.service

[Service]
Type=oneshot

# Credentials are sealed with systemd-creds (TPM2 + host key) and exposed
# only as files under $CREDENTIALS_DIRECTORY for the lifetime of this unit.
# Nothing is written to disk in plaintext.
LoadCredentialEncrypted=repopw:/etc/credstore.encrypted/restic-repo-password
LoadCredentialEncrypted=aws:/etc/credstore.encrypted/restic-aws-credentials

Environment=RESTIC_REPOSITORY=s3:https://s3.wasabisys.com/ck-arch
Environment=AWS_DEFAULT_REGION=us-east-1
Environment=RESTIC_CACHE_DIR=/var/cache/restic
Environment=TMPDIR=/var/cache/restic

ExecStart=/usr/bin/env \
    RESTIC_PASSWORD_FILE=%d/repopw \
    AWS_SHARED_CREDENTIALS_FILE=%d/aws \
    /usr/bin/restic backup \
    --files-from /etc/restic/include.txt \
    --exclude-file /etc/restic/exclude.txt \
    --tag critical \
    --verbose

ExecStartPost=/usr/bin/env \
    RESTIC_PASSWORD_FILE=%d/repopw \
    AWS_SHARED_CREDENTIALS_FILE=%d/aws \
    /usr/bin/restic forget \
    --tag critical \
    --keep-daily 14 --keep-weekly 8 --keep-monthly 6

Nice=19
IOSchedulingClass=idle
CacheDirectory=restic
CacheDirectoryMode=0700

# Hardening: this unit reads sensitive paths, so limit what else it can touch.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
